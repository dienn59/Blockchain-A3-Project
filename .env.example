# Deployer wallet private key (no 0x prefix is fine; with 0x also works)
PRIVATE_KEY=

# Optional scan relayer. Use a funded throwaway wallet; never expose this key
# in frontend files. RELAYER_PRIVATE_KEY defaults to PRIVATE_KEY if omitted.
RELAYER_PRIVATE_KEY=
RELAYER_RPC_URL=
RELAYER_PORT=8080
RELAYER_RATE_LIMIT_MS=3000
CONTRACT_ADDRESS=

# Polygon Mainnet RPC (Alchemy / Infura / public node)
POLYGON_RPC_URL=https://polygon-rpc.com

# Polygon Amoy testnet RPC (Mumbai is deprecated; Amoy is the current testnet)
POLYGON_AMOY_RPC_URL=

# Polygonscan API key for contract verification
POLYGONSCAN_API_KEY=

# Set to "true" to enable hardhat-gas-reporter output during tests
REPORT_GAS=false
