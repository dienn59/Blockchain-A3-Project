# Deployer wallet private key (no 0x prefix is fine; with 0x also works)
PRIVATE_KEY=

# Polygon Mainnet RPC (Alchemy / Infura / public node)
POLYGON_RPC_URL=https://polygon-rpc.com

# Polygon Amoy testnet RPC (Mumbai is deprecated; Amoy is the current testnet)
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# Polygonscan API key for contract verification
POLYGONSCAN_API_KEY=

# Set to "true" to enable hardhat-gas-reporter output during tests
REPORT_GAS=false
